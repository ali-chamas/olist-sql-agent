# Copy to .env and fill in. Real environment variables win over this file.

# --- Free option 1: Groq (https://console.groq.com/keys, no card needed) ---
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b        # the default for groq

# --- Free option 2: Google Gemini (https://aistudio.google.com/apikey) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-flash-latest

# --- Free option 3: OpenRouter free models (low daily request limit) ---
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_MODEL=openrouter/free

# --- Free option 4: a local model with Ollama (no key, no limits) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=<a model you pulled that supports tool calling>

# --- Paid: Claude ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# --- Any other OpenAI-compatible server ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=
# LLM_MODEL=

# Web app limits (matter for a public demo)
# DAILY_TOKEN_BUDGET=150000   # stop calling the model after this many tokens per UTC day; 0 = no cap
# ASK_PER_MINUTE=10           # questions per client per minute
# QUERY_PER_MINUTE=60         # dashboard and SQL-editor queries per client per minute
# APP_PASSWORD=                # set to require a password (HTTP Basic) for every page and API call
# APP_DB_PATH=data/app.db     # saved dashboards (writable, separate from the read-only data)
# CACHE_TTL_S=86400           # how long an answer is reused for the same question
# TRUST_PROXY=1               # behind a reverse proxy: read the client address from X-Forwarded-For

# Optional tuning
# DB_PATH=data/olist.db
# MAX_STEPS=6
# MAX_ROWS=200
# QUERY_TIMEOUT_S=5
